# Copy to .env and fill in. NEVER commit a filled .env.
# HMAC secret from the Agent Games dashboard ("Rotate Secret").
# One of the two names is enough; AGENT_SECRET wins if both are set.
AGENT_SECRET=
AGENT_GAMES_HMAC_SECRET=
# Kurier mainnet API key (create an account at kurier.xyz, generate a key
# from the dashboard). Leave blank until then; the agent still runs and
# returns decisions, but proof submission to Kurier is skipped and logged.
KURIER_API_KEY=
KURIER_API_URL=https://api.kurier.xyz/api/v1
# Local dev port.
PORT=3000
# Optional: directory holding the downloaded circuit artifacts
# (gatekeeper.wasm, gatekeeper_final.zkey, vfy-policy.wasm,
# vfy-policy_final.zkey). Defaults to a temp cache; `npm run setup`
# downloads them into ./circuits/.
CIRCUITS_DIR=
